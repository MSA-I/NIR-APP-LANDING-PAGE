---
import '../styles/global.css';
import { LOCALES, LOCALE_META, PRICING, type Locale } from '../lib/i18n';
import type { Dict } from '../content/he';
import Nav from '../components/marketing/Nav.astro';
import Footer from '../components/marketing/Footer.astro';

interface Props {
  locale: Locale;
  dict: Dict;
}
const { locale, dict } = Astro.props;
const meta = LOCALE_META[locale];
const site = 'https://inplace.digital';
const canonical = site + meta.path;
const currency = locale === 'he' ? 'ILS' : 'USD';

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'InPlace',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: dict.meta.description,
  url: site,
  inLanguage: ['he', 'en', 'fr'],
  offers: PRICING.plans.map((p) => ({
    '@type': 'Offer',
    name: dict.pricing.plans[p.id as keyof typeof dict.pricing.plans].name,
    price: locale === 'he' ? p.ils : p.usd,
    priceCurrency: currency,
  })),
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: dict.faq.items.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<!doctype html>
<html lang={meta.lang} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{dict.meta.title}</title>
    <meta name="description" content={dict.meta.description} />
    <link rel="canonical" href={canonical} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={site + LOCALE_META[l].path} />)}
    <link rel="alternate" hreflang="x-default" href={site + '/'} />
    <link rel="icon" type="image/svg+xml" href="/brand/inplace-symbol.svg" />
    <link rel="preload" href="/fonts/heebo-var-hebrew.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/heebo-var-latin.woff2" as="font" type="font/woff2" crossorigin />
    {locale === 'he' && <link rel="preload" href="/fonts/suez-one-hebrew.woff2" as="font" type="font/woff2" crossorigin />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="InPlace" />
    <meta property="og:title" content={dict.meta.title} />
    <meta property="og:description" content={dict.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'he' ? 'he_IL' : locale === 'en' ? 'en_US' : 'fr_FR'} />
    <meta property="og:image" content={site + '/media/og-cover.jpg'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={dict.meta.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={site + '/media/og-cover.jpg'} />
    <script type="application/ld+json" set:html={JSON.stringify(softwareLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </head>
  <body>
    <Nav locale={locale} dict={dict} />
    <slot />
    <Footer locale={locale} dict={dict} />
    <script>
      import { track } from '../lib/analytics';

      // Static CTAs: any element carrying data-track reports its click.
      document.addEventListener('click', (e) => {
        const el = (e.target as Element | null)?.closest?.('[data-track]');
        if (!el) return;
        const d = (el as HTMLElement).dataset;
        track(d.track!, d.trackPlace ? { place: d.trackPlace } : {});
      });

      // Web vitals (doc §16.3): LCP + CLS + INP approximation, reported once
      // when the page is hidden. Hand-rolled observers; no dependency.
      try {
        let lcp = 0;
        let cls = 0;
        let inp = 0;
        new PerformanceObserver((l) => {
          const last = l.getEntries().at(-1) as PerformanceEntry | undefined;
          if (last) lcp = last.startTime;
        }).observe({ type: 'largest-contentful-paint', buffered: true });
        new PerformanceObserver((l) => {
          for (const e of l.getEntries() as PerformanceEntry[]) {
            const s = e as unknown as { hadRecentInput: boolean; value: number };
            if (!s.hadRecentInput) cls += s.value;
          }
        }).observe({ type: 'layout-shift', buffered: true });
        new PerformanceObserver((l) => {
          for (const e of l.getEntries()) inp = Math.max(inp, e.duration);
        }).observe({ type: 'event', buffered: true, durationThreshold: 40 } as PerformanceObserverInit);
        let sent = false;
        const report = () => {
          if (sent) return;
          sent = true;
          track('web_vitals', { lcp: Math.round(lcp), cls: Math.round(cls * 1000) / 1000, inp: Math.round(inp) });
        };
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'hidden') report();
        });
        addEventListener('pagehide', report);
      } catch {
        /* older browsers: no vitals, page unaffected */
      }

      // Section entrance: auto-tag heads, cards and rows as .reveal, stagger
      // siblings via --ri, one shared observer adds .in once. Reduced motion:
      // the .reveal styles don't exist, so tagging is inert.
      if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        // Scroll-driven product scenes: CSS view() owns these where supported;
        // otherwise they stay in the auto-reveal system below.
        const SCENES = ['.leaks .card', '.asst-card', '.roles-widget', '.gdemo', '.roi-results'];
        const viewSupported = CSS.supports('animation-timeline: view()');
        if (viewSupported) {
          document.querySelectorAll<HTMLElement>(SCENES.join(',')).forEach((el) => el.classList.add('scene'));
        }

        const AUTO = [
          '.section-head',
          '.trail-head',
          '.proof h2',
          '.proof .item',
          '.leaks .card',
          '.trail-static li',
          '.asst-side',
          '.asst-card',
          '.roles-widget',
          '.gdemo',
          '.roi-inputs',
          '.roi-results',
          '.period-toggle',
          '.plan',
          '.sec-item',
          '.story .container > *',
          '.faq-item',
          '.final-inner > *',
        ];
        document.querySelectorAll<HTMLElement>(AUTO.join(',')).forEach((el) => {
          if (el.closest('.hero')) return; // hero has its own choreography
          if (el.classList.contains('scene')) return; // scroll-driven instead
          el.classList.add('reveal');
        });
        // Stagger: index each .reveal among .reveal siblings of the same parent.
        document.querySelectorAll<HTMLElement>('.reveal').forEach((el) => {
          let i = 0;
          let sib = el.previousElementSibling;
          while (sib) {
            if (sib.classList.contains('reveal')) i++;
            sib = sib.previousElementSibling;
          }
          el.style.setProperty('--ri', String(Math.min(i, 7)));
        });
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -36px 0px' }
        );
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      }

      // Nav condenses once the page scrolls.
      const navWrap = document.querySelector('.nav-wrap');
      const onScroll = () => navWrap?.classList.toggle('scrolled', window.scrollY > 6);
      onScroll();
      addEventListener('scroll', onScroll, { passive: true });

      // Breakpoint-dependent motion is re-evaluated on change, not read once at
      // load: resizing or rotating across 1024px used to leave the spine and the
      // chapter tint in the wrong mode for the rest of the session.
      const wide = window.matchMedia('(min-width: 1024px)');
      const motionOk = window.matchMedia('(prefers-reduced-motion: no-preference)');
      let enhanced = false;
      const setupEnhanced = () => {
        if (enhanced || !wide.matches || !motionOk.matches) return;
        enhanced = true;
        // Scroll spine: the money trail follows the reader down the page.
        const spine = document.createElement('div');
        spine.className = 'spine';
        spine.setAttribute('aria-hidden', 'true');
        spine.innerHTML = '<div class="spine-track"></div><div class="spine-fill"></div><div class="spine-chip"></div>';
        document.body.appendChild(spine);
        let raf = 0;
        const updateSpine = () => {
          raf = 0;
          const max = document.documentElement.scrollHeight - innerHeight;
          spine.style.setProperty('--sp', String(max > 0 ? Math.min(1, scrollY / max) : 0));
        };
        updateSpine();
        addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(updateSpine); }, { passive: true });
        addEventListener('resize', () => { if (!raf) raf = requestAnimationFrame(updateSpine); }, { passive: true });

        // Chapter color travel: the section crossing the viewport middle tints
        // the page ground (warm/cool/base).
        const CHAPTERS: [string, string][] = [
          ['.hero', 'base'],
          ['#leaks', 'warm'],
          ['#assistant', 'cool'],
          ['#roles', 'base'],
          ['#demo', 'cool'],
          ['#roi', 'warm'],
          ['#pricing', 'base'],
          ['.story', 'warm'],
          ['#faq', 'warm'],
        ];
        const chapterIo = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              const tint = (e.target as HTMLElement).dataset.chapter || 'base';
              if (tint === 'base') delete document.body.dataset.chapter;
              else document.body.dataset.chapter = tint;
            }
          },
          { rootMargin: '-45% 0px -45% 0px' }
        );
        for (const [sel, tint] of CHAPTERS) {
          const el = document.querySelector<HTMLElement>(sel);
          if (el) {
            el.dataset.chapter = tint;
            chapterIo.observe(el);
          }
        }
      };
      setupEnhanced();
      wide.addEventListener('change', setupEnhanced);
      motionOk.addEventListener('change', setupEnhanced);
    </script>
  </body>
</html>
