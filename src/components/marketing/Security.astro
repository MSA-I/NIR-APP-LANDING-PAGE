---
import type { Dict } from '../../content/he';

interface Props {
  dict: Dict;
}
const { dict } = Astro.props;
/* Each icon is chosen for the statement it sits next to, in the order the copy
   declares them. Positional assignment (icons[i % len]) put a clock next to
   row isolation and a padlock next to the assistant; the glyph has to mean the
   sentence or it is noise. Order matches security.items in the dictionaries:
   tenant isolation, three roles, audit log, grounded assistant, payment chain,
   isolated demo. */
const icons = [
  // isolation: stacked database rows, separated
  'M4 6.5c0-1.4 3.6-2.5 8-2.5s8 1.1 8 2.5-3.6 2.5-8 2.5-8-1.1-8-2.5ZM4 12c0 1.4 3.6 2.5 8 2.5s8-1.1 8-2.5M4 6.5v11C4 18.9 7.6 20 12 20s8-1.1 8-2.5v-11',
  // three roles: three people
  'M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm7.5.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM3 20c0-3 2.7-5 6-5s6 2 6 5m2.5-5.5c2 .6 3.5 2.3 3.5 4.5',
  // audit log: list with a checked entry and a reason line
  'M5 4h11l3 3v13H5V4Zm3.5 8.5 1.5 1.5 3-3M8.5 17h7',
  // grounded assistant: an answer linked to its source
  'M10 13a5 5 0 0 0 7.5.5l2-2a5 5 0 0 0-7-7l-1 1M14 11a5 5 0 0 0-7.5-.5l-2 2a5 5 0 0 0 7 7l1-1',
  // payment chain: a shielded transaction
  'M12 3 5 6v5.5c0 4 3 7.6 7 8.5 4-.9 7-4.5 7-8.5V6l-7-3Zm-3 8.5h6m-3-3v6',
  // isolated demo: a sandbox boundary
  'M4 8V5.5A1.5 1.5 0 0 1 5.5 4H8m8 0h2.5A1.5 1.5 0 0 1 20 5.5V8m0 8v2.5a1.5 1.5 0 0 1-1.5 1.5H16m-8 0H5.5A1.5 1.5 0 0 1 4 18.5V16m5-4h6',
];
---

<section class="section security" id="security">
  <div class="container">
    <div class="section-head">
      <h2>{dict.security.h2}</h2>
      <p>{dict.security.sub}</p>
    </div>
    <div class="sec-grid">
      {dict.security.items.map((item, i) => (
        <div class="sec-item">
          <span class="sec-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={icons[i]} />
            </svg>
          </span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .security {
    background: var(--wheat);
  }
  .sec-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 26px 40px;
  }
  .sec-item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }
  .sec-icon {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    inline-size: 42px;
    block-size: 42px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--oceanic) 9%, transparent);
    color: var(--oceanic);
  }
  .sec-item h3 {
    font-size: 16.5px;
  }
  .sec-item p {
    margin-block-start: 6px;
    font-size: 14.5px;
    color: var(--ink-mid);
    max-inline-size: 44ch;
  }
  @media (min-width: 768px) {
    .sec-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .sec-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
