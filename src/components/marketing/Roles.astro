---
import type { Dict } from '../../content/he';
import { getFixtures } from '../../content/fixtures';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
  dict: Dict;
}
const { locale, dict } = Astro.props;
const tabs = dict.roles.tabs;
const fx = getFixtures(locale);
---

<section class="section roles" id="roles">
  <div class="container">
    <div class="section-head">
      <h2>{dict.roles.h2}</h2>
      <p>{dict.roles.sub}</p>
    </div>

    <div class="roles-widget" data-roles>
      <div class="roles-tabs" role="tablist" aria-label={dict.roles.h2}>
        {tabs.map((t, i) => (
          <button class="roles-tab" role="tab" id={`role-tab-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`role-panel-${t.id}`} tabindex={i === 0 ? 0 : -1}>
            {t.label}
          </button>
        ))}
      </div>
      {tabs.map((t, i) => (
        <div class="roles-panel" role="tabpanel" id={`role-panel-${t.id}`} aria-labelledby={`role-tab-${t.id}`} hidden={i !== 0}>
          <div class="role-summary">
            <h3>{t.label}</h3>
            <p>{t.summary}</p>
            <ul class="role-sees">
              {t.sees.map((s) => (
                <li>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M4.5 12.5l5 5 10-11" /></svg>
                  <span>{s}</span>
                </li>
              ))}
            </ul>
            <p class="role-blocked">{t.blocked}</p>
          </div>
          <div class="role-visual">
            <div class="pui">
              <div class="pui-titlebar">
                <span>{dict.roles.invoiceCaption} {t.label}</span>
                {t.id === 'accountant' ? (
                  <span class="badge badge-idle">
                    <span class="num tech-id" dir="ltr">{dict.heroUi.invoiceId}</span>
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" role="img" aria-label={fx.noAccessLabel}><path d="M6 6l12 12M18 6L6 18" /></svg>
                  </span>
                ) : (
                  <span class="badge badge-alert">{dict.heroUi.statusBlocked}</span>
                )}
              </div>
              {t.id === 'owner' && (
                <>
                  <div class="pui-row"><span><bdi>{dict.heroUi.supplier}</bdi></span><span class="num">{fx.rolesAmount}</span></div>
                  <div class="pui-row"><span>{dict.heroUi.reason}</span><span class="num" style="color: var(--alert-fg); font-weight: 600;">{dict.heroUi.deltaValue}</span></div>
                  <div class="pui-row"><span class="badge badge-await">{tabs[0].label}</span><span style="color: var(--action); font-weight: 500;">{dict.heroUi.action}</span></div>
                </>
              )}
              {t.id === 'office' && (
                <>
                  <div class="pui-row"><span><bdi>{dict.heroUi.supplier}</bdi></span><span class="num">{fx.rolesAmount}</span></div>
                  <div class="pui-row">
                    <span>{dict.heroUi.chain[0].label} · {dict.heroUi.chain[1].label}</span>
                    <span class="badge badge-done">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" role="img" aria-label={fx.okLabel}><path d="M4.5 12.5l5 5 10-11" /></svg>
                    </span>
                  </div>
                  <div class="pui-row"><span>{tabs[1].blocked}</span><span class="badge badge-idle" aria-label={fx.noAccessLabel}>—</span></div>
                </>
              )}
              {t.id === 'accountant' && (
                <>
                  <div class="pui-row"><span><bdi>{fx.suppliers.bakery}</bdi> · <span class="num tech-id" dir="ltr">INV-2298</span></span><span class="badge badge-done">{fx.approvedLabel}</span></div>
                  <div class="pui-row"><span><bdi>{fx.suppliers.farm}</bdi> · <span class="num tech-id" dir="ltr">INV-2301</span></span><span class="badge badge-done">{fx.approvedLabel}</span></div>
                  <div class="pui-row">
                    <span>{tabs[2].sees[0]}</span>
                    <span class="badge badge-idle">
                      <span class="num tech-id" dir="ltr">{dict.heroUi.invoiceId}</span>
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" role="img" aria-label={fx.noAccessLabel}><path d="M6 6l12 12M18 6L6 18" /></svg>
                    </span>
                  </div>
                </>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .roles {
    background: transparent; /* body carries the chapter tint */
  }
  .role-visual .pui {
    font-size: 14px;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-roles]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const select = (i: number) => {
      tabs.forEach((t, ti) => {
        const on = ti === i;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p, pi) => (p.hidden = pi !== i));
      tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const rtl = document.documentElement.dir === 'rtl';
        let target: number;
        if (e.key === 'ArrowRight') target = rtl ? i - 1 : i + 1;
        else if (e.key === 'ArrowLeft') target = rtl ? i + 1 : i - 1;
        else if (e.key === 'ArrowDown') target = i + 1;
        else if (e.key === 'ArrowUp') target = i - 1;
        else if (e.key === 'Home') target = 0;
        else if (e.key === 'End') target = tabs.length - 1;
        else return;
        e.preventDefault();
        select((target + tabs.length) % tabs.length);
      });
    });
  });
</script>
