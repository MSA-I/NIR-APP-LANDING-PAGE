---
import { PRICING, APP_URL, type Locale } from '../../lib/i18n';
import type { Dict } from '../../content/he';

/**
 * The plan ladder, published as VOLUME rather than price.
 *
 * Owner ruling, 25.08.2026: no amount reaches a public surface before launch. The catalogue of
 * #195 is decided and seeded in the product, and a customer is given their figure inside their
 * account at the moment of upgrade — in the currency of their VERIFIED billing address. A visitor
 * to this page has no verified billing address, so the site cannot even say which of the two
 * catalogues applies to them; naming one would be presenting a guess as a fact.
 *
 * What went with the prices: the monthly/yearly toggle, which existed only to switch which figure
 * was shown and would otherwise be a control that changes nothing on the page.
 */
interface Props {
  locale: Locale;
  dict: Dict;
}
const { locale, dict } = Astro.props;
const p = dict.pricing;
const fmt = (n: number) => new Intl.NumberFormat(locale === 'he' ? 'he-IL' : locale === 'fr' ? 'fr-FR' : 'en-US').format(n);
---

<section class="section pricing" id="pricing">
  <div class="container">
    <div class="section-head">
      <h2>{p.h2}</h2>
      <p>{p.sub}</p>
    </div>

    <div class="plans">
      {PRICING.plans.map((plan) => {
        const info = p.plans[plan.id as keyof typeof p.plans];
        const highlighted = plan.id === 'premium';
        return (
          <article class={`plan card ${highlighted ? 'plan-hi' : ''}`}>
            {highlighted && 'highlight' in info && <span class="plan-flag">{(info as { highlight: string }).highlight}</span>}
            <h3>{info.name}</h3>
            <p class="tagline">{info.tagline}</p>
            <ul class="quota">
              <li><span class="num">{fmt(plan.docs)}</span> {p.quota.docs}</li>
              <li><span class="num">{fmt(plan.assistant)}</span> {p.quota.assistant}</li>
            </ul>
            <div class="plan-action">
              <a
                class={`btn plan-cta ${plan.id === 'free' ? 'btn-primary' : plan.id === 'premium' ? 'btn-onyx' : 'btn-ghost'}`}
                href={`${APP_URL}?plan=${plan.id}`}
                data-track="pricing_plan_click"
                data-track-place={plan.id}
              >
                {p.planCta[plan.id as keyof typeof p.planCta]}
              </a>
              {plan.id !== 'free' && <span class="plan-cta-note">{p.planCtaNote}</span>}
            </div>
          </article>
        );
      })}
    </div>

    <ul class="pricing-notes">
      <li>{p.introNote}</li>
      <li>{p.upgradeNote}</li>
      <li>{p.priceNote}</li>
    </ul>
  </div>
</section>

<style>
  .pricing {
    background: transparent; /* body carries the chapter tint */
  }
  .plans {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  .plan {
    position: relative;
    padding: 28px 26px;
    display: flex;
    flex-direction: column;
  }
  .plan-hi {
    background: var(--oceanic);
    color: var(--on-action);
  }
  .plan-hi .tagline,
  .plan-hi .quota {
    color: color-mix(in srgb, var(--on-action) 82%, transparent);
  }
  .plan-flag {
    position: absolute;
    inset-block-start: 18px;
    inset-inline-end: 20px;
    background: var(--wheat);
    color: var(--oceanic);
    font-size: 12px;
    font-weight: var(--fw-medium);
    padding: 4px 12px;
    border-radius: var(--r-pill);
  }
  .plan h3 {
    font-size: 20px;
  }
  .tagline {
    margin-block-start: 4px;
    font-size: 13.5px;
    color: var(--ink-muted);
    min-block-size: 2.6em; /* two lines: keeps the four quota blocks on one baseline (fr wraps) */
  }
  /* The volume figures now carry the card the way the price used to, so they take the weight the
     price line had. */
  .quota {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
    font-size: 15px;
    color: var(--ink-mid);
  }
  .quota .num {
    font-size: 26px;
    font-weight: var(--fw-semibold);
    letter-spacing: -0.01em;
    color: currentColor;
    margin-inline-end: 3px;
  }
  .plan-cta {
    margin-block-start: 24px;
    margin-block-end: 0;
  }
  .plan {
    justify-content: flex-start;
  }
  .plan .plan-action {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
    margin-block-start: auto;
    padding-block-start: 24px;
  }
  .plan .plan-cta {
    margin-block: 0;
    inline-size: 100%;
  }
  /* The free-first path belongs on the card the reader is deciding about,
     not in a footnote under the whole grid. */
  .plan-cta-note {
    font-size: 12px;
    color: var(--ink-muted);
    text-align: center;
  }
  .plan .quota {
    margin-block-end: 24px;
  }
  .pricing-notes {
    margin-block-start: 24px;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 6px;
    font-size: 13.5px;
    color: var(--ink-muted);
    max-inline-size: 70ch;
  }
  @media (min-width: 768px) {
    .plans {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1200px) {
    .plans {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .plan-cta {
      padding-inline: 14px;
      font-size: 14.5px;
    }
  }
</style>
