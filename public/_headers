# Cloudflare Pages reads this file from the root of the published output.
#
# The Content-Security-Policy is NOT written here. It is appended to the built
# copy of this file by scripts/build-csp.mjs, one rule per page, because it
# carries a hash of every inline script on that page and there are fifty-two of
# them across nineteen pages. A hash written by hand is a hash that goes stale
# the first time the script it covers is edited.
#
# It ships as Content-Security-Policy-Report-Only, by the plan this file has
# carried since the first round: motion writes an inline style attribute on
# every animated element, and a strict style-src would stop the page animating
# without stopping it loading, which is the worst kind of failure to notice.
# Report-only browsers evaluate and report; nothing is blocked. `--enforce`
# switches the header name, and that is the owner's call once the violations
# are known to be empty.
#
# HSTS carries no `preload` token. Preloading is close to irreversible and it
# covers every subdomain including app.inplace.digital, so it is the owner's
# call to make deliberately, not a side effect of a landing page deploy.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  X-Frame-Options: SAMEORIGIN

# Vite hashes every filename under /assets, so these can never go stale.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# These three are addressed by name and must be allowed to change.
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
/
  Cache-Control: public, max-age=0, must-revalidate
